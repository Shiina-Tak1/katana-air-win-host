<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>KatanaAirWinHost</AssemblyName>
    <RootNamespace>KatanaAirWinHost</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Page injection scripts (head.js / tail.js) are embedded into the executable and served at
      GET /__host/<file name> at run time.
      The wildcard keeps the build working while a script is absent; the host then logs a warning
      and skips that injection.
    -->
    <EmbeddedResource Include="Web\inject\*.js" LogicalName="inject/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
